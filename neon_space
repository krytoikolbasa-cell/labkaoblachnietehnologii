<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Neon Space Defender</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;700&display=swap');

        body {
            font-family: 'Rajdhani', sans-serif;
            background-color: #05050b;
            color: #fff;
            overflow: hidden;
            touch-action: none;
            user-select: none;
        }

        .font-orbitron {
            font-family: 'Orbitron', sans-serif;
        }

        .neon-text-cyan {
            text-shadow: 0 0 8px rgba(6, 182, 212, 0.8), 0 0 20px rgba(6, 182, 212, 0.5);
        }

        .neon-text-pink {
            text-shadow: 0 0 8px rgba(236, 72, 153, 0.8), 0 0 20px rgba(236, 72, 153, 0.5);
        }

        .neon-box-cyan {
            box-shadow: 0 0 15px rgba(6, 182, 212, 0.4), inset 0 0 15px rgba(6, 182, 212, 0.2);
            border: 1px solid rgba(6, 182, 212, 0.6);
        }

        .neon-box-pink {
            box-shadow: 0 0 15px rgba(236, 72, 153, 0.4), inset 0 0 15px rgba(236, 72, 153, 0.2);
            border: 1px solid rgba(236, 72, 153, 0.6);
        }

        .btn-neon {
            transition: all 0.2s ease-in-out;
            position: relative;
            overflow: hidden;
        }

        .btn-neon::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(60deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transform: rotate(30deg);
            transition: 0.5s;
        }

        .btn-neon:hover::after {
            left: 100%;
        }

        .btn-neon:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.8);
        }

        /* Glassmorphism */
        .glass-panel {
            background: rgba(10, 15, 30, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
    </style>
</head>
<body class="w-screen h-screen flex items-center justify-center m-0 p-0 relative">

    <!-- Игровой холст -->
    <canvas id="gameCanvas" class="absolute inset-0 w-full h-full block z-0"></canvas>

    <!-- Игровой Интерфейс HUD -->
    <div id="hud" class="absolute top-0 left-0 w-full p-4 flex justify-between items-start pointer-events-none z-10 hidden">
        <!-- Левый блок: Здоровье и Щит -->
        <div class="flex flex-col gap-2 w-48 md:w-64">
            <!-- Здоровье -->
            <div class="glass-panel p-2 rounded-lg border border-cyan-500/30">
                <div class="flex justify-between text-xs font-bold text-cyan-400 mb-1">
                    <span><i class="fa-solid fa-heart text-red-500 mr-1"></i> КОРПУС</span>
                    <span id="hpText">100%</span>
                </div>
                <div class="w-full bg-slate-900/80 rounded-full h-3 overflow-hidden border border-slate-700">
                    <div id="hpBar" class="bg-gradient-to-r from-red-500 to-cyan-400 h-full w-full transition-all duration-200"></div>
                </div>
            </div>
            <!-- Щит -->
            <div id="shieldHud" class="glass-panel p-2 rounded-lg border border-blue-500/30 opacity-50 transition-opacity duration-300">
                <div class="flex justify-between text-xs font-bold text-blue-400 mb-1">
                    <span><i class="fa-solid fa-shield-halved mr-1"></i> ЭНЕРГОЩИТ</span>
                    <span id="shieldText">ВЫКЛ</span>
                </div>
                <div class="w-full bg-slate-900/80 rounded-full h-2 overflow-hidden border border-slate-700">
                    <div id="shieldBar" class="bg-blue-400 h-full w-0 transition-all duration-200"></div>
                </div>
            </div>
        </div>

        <!-- Центральный блок: Волны и Множитель -->
        <div class="text-center glass-panel px-6 py-2 rounded-xl border border-cyan-500/40">
            <div class="text-xs text-slate-400 uppercase tracking-widest font-orbitron">ВОЛНА</div>
            <div id="waveText" class="text-2xl md:text-3xl font-black text-cyan-400 font-orbitron neon-text-cyan">1</div>
            <div id="timeSlowIndicator" class="text-xs text-purple-400 font-bold hidden animate-pulse mt-1">
                <i class="fa-solid fa-hourglass-half"></i> ЗАМЕДЛЕНИЕ
            </div>
        </div>

        <!-- Правый блок: Очки и Бонусы -->
        <div class="flex flex-col items-end gap-2">
            <div class="glass-panel p-3 rounded-lg border border-purple-500/30 text-right min-w-[140px]">
                <div class="text-xs text-purple-300 uppercase font-orbitron">СЧЁТ</div>
                <div id="scoreText" class="text-xl md:text-2xl font-bold text-pink-500 font-orbitron neon-text-pink">0</div>
                <div class="text-xs text-slate-400 mt-1">РЕКОРД: <span id="hudHighScore" class="text-amber-400 font-bold">0</span></div>
            </div>

            <!-- Иконки активных бонусов -->
            <div id="activePowers" class="flex gap-2 mt-1"></div>
        </div>
    </div>

    <!-- Главное Меню -->
    <div id="mainMenu" class="absolute z-20 flex flex-col items-center justify-center inset-0 glass-panel p-6">
        <div class="max-w-md w-full text-center space-y-6">
            <div class="space-y-2">
                <h1 class="text-4xl md:text-6xl font-black italic tracking-wider font-orbitron text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-pink-500 to-purple-500 neon-text-cyan">
                    NEON DEFENDER
                </h1>
                <p class="text-slate-400 text-sm md:text-base font-medium">Кибернетический космос ждёт своего защитника</p>
            </div>

            <div class="glass-panel p-4 rounded-xl border border-slate-700/50 text-left text-xs md:text-sm text-slate-300 space-y-2">
                <div class="font-bold text-cyan-400 mb-2 uppercase border-b border-slate-700 pb-1">Управление:</div>
                <div class="flex justify-between"><span>Движение:</span> <span class="text-slate-100 font-mono">WASD / Стрелки / Мышь</span></div>
                <div class="flex justify-between"><span>Стрельба:</span> <span class="text-slate-100 font-mono">Автоматическая / ЛКМ</span></div>
                <div class="flex justify-between"><span>Пауза:</span> <span class="text-slate-100 font-mono">P или ESC</span></div>
            </div>

            <div class="flex justify-between items-center text-xs text-amber-400 font-orbitron px-2">
                <span>ЛУЧШИЙ РЕЗУЛЬТАТ:</span>
                <span id="menuHighScore" class="text-base font-bold text-amber-300">0</span>
            </div>

            <button id="startBtn" class="btn-neon w-full py-4 bg-gradient-to-r from-cyan-500 to-blue-600 rounded-xl font-orbitron font-bold text-lg text-white shadow-lg tracking-wider">
                НАЧАТЬ БОЙ <i class="fa-solid fa-play ml-2"></i>
            </button>
        </div>
    </div>

    <!-- Экран Game Over -->
    <div id="gameOverScreen" class="absolute z-20 flex flex-col items-center justify-center inset-0 glass-panel p-6 hidden">
        <div class="max-w-md w-full text-center space-y-6">
            <h2 class="text-4xl md:text-5xl font-black font-orbitron text-red-500 neon-text-pink animate-bounce">
                МИССИЯ ПРОВАЛЕНА
            </h2>

            <div class="glass-panel p-6 rounded-2xl border border-red-500/30 space-y-4">
                <div>
                    <div class="text-xs text-slate-400 font-orbitron">ИТОГОВЫЙ СЧЁТ</div>
                    <div id="finalScore" class="text-4xl font-black text-cyan-400 font-orbitron neon-text-cyan">0</div>
                </div>

                <div class="flex justify-around border-t border-slate-700 pt-3">
                    <div>
                        <div class="text-xs text-slate-400">ПРОЙДЕНО ВОЛН</div>
                        <div id="finalWaves" class="text-xl font-bold text-purple-400 font-orbitron">0</div>
                    </div>
                    <div>
                        <div class="text-xs text-slate-400">УНИЧТОЖЕНО ВРАГОВ</div>
                        <div id="finalKills" class="text-xl font-bold text-pink-400 font-orbitron">0</div>
                    </div>
                </div>

                <div id="newHighscoreMsg" class="hidden text-amber-400 font-bold font-orbitron text-sm animate-pulse">
                    <i class="fa-solid fa-trophy mr-1"></i> НОВЫЙ РЕКОРД!
                </div>
            </div>

            <button id="restartBtn" class="btn-neon w-full py-4 bg-gradient-to-r from-pink-500 to-purple-600 rounded-xl font-orbitron font-bold text-lg text-white shadow-lg tracking-wider">
                ПОПРОБОВАТЬ СНОВА <i class="fa-solid fa-rotate-right ml-2"></i>
            </button>
        </div>
    </div>

    <!-- Экран Паузы -->
    <div id="pauseScreen" class="absolute z-20 flex flex-col items-center justify-center inset-0 glass-panel p-6 hidden">
        <div class="text-center space-y-6">
            <h2 class="text-4xl font-black font-orbitron text-cyan-400 neon-text-cyan">ПАУЗА</h2>
            <button id="resumeBtn" class="btn-neon px-8 py-3 bg-cyan-600 rounded-xl font-orbitron font-bold text-white">ПРОДОЛЖИТЬ</button>
        </div>
    </div>

    <!-- Мобильное управление (сенсорные зоны) -->
    <div id="touchControls" class="absolute bottom-4 right-4 z-10 md:hidden flex gap-3 opacity-70">
        <div id="touchFireBtn" class="w-16 h-16 rounded-full bg-red-500/30 border border-red-400 flex items-center justify-center text-white text-xl active:bg-red-500/60">
            <i class="fa-solid fa-crosshairs"></i>
        </div>
    </div>

    <script>
        // --- Web Audio API Synth Engine ---
        class SoundFX {
            constructor() {
                this.ctx = null;
                this.muted = false;
            }

            init() {
                if (!this.ctx) {
                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
                }
            }

            playLaser() {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(800, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(100, this.ctx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.2, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.15);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.15);
            }

            playExplosion(isBig = false) {
                if (!this.ctx) return;
                const dur = isBig ? 0.5 : 0.3;
                const bufferSize = this.ctx.sampleRate * dur;
                const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = Math.random() * 2 - 1;
                }

                const noise = this.ctx.createBufferSource();
                noise.buffer = buffer;

                const filter = this.ctx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(isBig ? 400 : 800, this.ctx.currentTime);
                filter.frequency.linearRampToValueAtTime(50, this.ctx.currentTime + dur);

                const gain = this.ctx.createGain();
                gain.gain.setValueAtTime(isBig ? 0.4 : 0.25, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + dur);

                noise.connect(filter);
                filter.connect(gain);
                gain.connect(this.ctx.destination);

                noise.start();
                noise.stop(this.ctx.currentTime + dur);
            }

            playPowerup() {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(300, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(1200, this.ctx.currentTime + 0.25);
                gain.gain.setValueAtTime(0.25, this.ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + 0.25);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.25);
            }

            playHit() {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(150, this.ctx.currentTime);
                osc.frequency.linearRampToValueAtTime(40, this.ctx.currentTime + 0.1);
                gain.gain.setValueAtTime(0.3, this.ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + 0.1);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.1);
            }
        }

        const audio = new SoundFX();

        // --- Основная логика игры ---
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        // Игровое состояние
        let state = 'MENU'; // MENU, PLAYING, PAUSED, GAMEOVER
        let score = 0;
        let kills = 0;
        let wave = 1;
        let highScore = parseInt(localStorage.getItem('neon_defender_highscore')) || 0;
        let lastTime = 0;
        let waveTimer = 0;
        let enemiesToSpawn = 0;

        // Размеры окна
        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        // Управление клавиатурой и мышью/тач
        const keys = {};
        const mouse = { x: canvas.width / 2, y: canvas.height / 2, down: false, active: false };

        window.addEventListener('keydown', e => {
            keys[e.code] = true;
            if (e.code === 'KeyP' || e.code === 'Escape') togglePause();
        });
        window.addEventListener('keyup', e => keys[e.code] = false);

        canvas.addEventListener('mousemove', e => {
            mouse.x = e.clientX;
            mouse.y = e.clientY;
            mouse.active = true;
        });

        canvas.addEventListener('mousedown', () => mouse.down = true);
        canvas.addEventListener('mouseup', () => mouse.down = false);

        canvas.addEventListener('touchmove', e => {
            if (e.touches.length > 0) {
                mouse.x = e.touches[0].clientX;
                mouse.y = e.touches[0].clientY;
                mouse.active = true;
            }
        }, { passive: true });

        canvas.addEventListener('touchstart', () => mouse.down = true, { passive: true });
        canvas.addEventListener('touchend', () => mouse.down = false, { passive: true });

        // --- Звёздный задний фон (Parallax Stars) ---
        const stars = [];
        for (let i = 0; i < 150; i++) {
            stars.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                size: Math.random() * 2,
                speed: Math.random() * 1.5 + 0.2,
                color: ['#06b6d4', '#ec4899', '#8b5cf6', '#ffffff'][Math.floor(Math.random() * 4)]
            });
        }

        function updateStars(dt, speedMultiplier = 1) {
            stars.forEach(s => {
                s.y += s.speed * speedMultiplier * (dt / 16);
                if (s.y > canvas.height) {
                    s.y = 0;
                    s.x = Math.random() * canvas.width;
                }
            });
        }

        function drawStars() {
            stars.forEach(s => {
                ctx.fillStyle = s.color;
                ctx.beginPath();
                ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
                ctx.fill();
            });
        }

        // --- Частицы (Explosions & Effects) ---
        class Particle {
            constructor(x, y, color, speed, size, life) {
                this.x = x;
                this.y = y;
                this.color = color;
                const angle = Math.random() * Math.PI * 2;
                this.vx = Math.cos(angle) * speed * (Math.random() + 0.5);
                this.vy = Math.sin(angle) * speed * (Math.random() + 0.5);
                this.size = size;
                this.maxLife = life;
                this.life = life;
            }

            update(dt) {
                this.x += this.vx * (dt / 16);
                this.y += this.vy * (dt / 16);
                this.life -= dt / 1000;
            }

            draw() {
                const alpha = Math.max(0, this.life / this.maxLife);
                ctx.save();
                ctx.globalAlpha = alpha;
                ctx.fillStyle = this.color;
                ctx.shadowBlur = 10;
                ctx.shadowColor = this.color;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }

        let particles = [];

        function createExplosion(x, y, color, count = 25, size = 3, speed = 4) {
            for (let i = 0; i < count; i++) {
                particles.push(new Particle(x, y, color, speed, Math.random() * size + 1, Math.random() * 0.4 + 0.2));
            }
        }

        // --- Игрок ---
        class Player {
            constructor() {
                this.width = 40;
                this.height = 40;
                this.x = canvas.width / 2;
                this.y = canvas.height - 100;
                this.speed = 7;
                this.maxHp = 100;
                this.hp = 100;
                this.shield = 0;
                this.maxShield = 100;

                // Оружие и апгрейды
                this.fireCooldown = 0;
                this.fireRate = 0.15; // секунды между выстрелами
                this.tripleShotTime = 0;
                this.sprayShotTime = 0;
                this.timeSlowTime = 0;

                this.color = '#06b6d4';
            }

            update(dt) {
                // Таймеры пауэрапов
                if (this.tripleShotTime > 0) this.tripleShotTime -= dt / 1000;
                if (this.sprayShotTime > 0) this.sprayShotTime -= dt / 1000;
                if (this.timeSlowTime > 0) this.timeSlowTime -= dt / 1000;

                // Движение клавиатурой
                let dx = 0;
                let dy = 0;
                if (keys['KeyA'] || keys['ArrowLeft']) dx -= 1;
                if (keys['KeyD'] || keys['ArrowRight']) dx += 1;
                if (keys['KeyW'] || keys['ArrowUp']) dy -= 1;
                if (keys['KeyS'] || keys['ArrowDown']) dy += 1;

                if (dx !== 0 && dy !== 0) {
                    dx *= 0.7071;
                    dy *= 0.7071;
                }

                if (dx !== 0 || dy !== 0) {
                    this.x += dx * this.speed * (dt / 16);
                    this.y += dy * this.speed * (dt / 16);
                } else if (mouse.active) {
                    // Плавно стремимся к курсору
                    const mx = mouse.x;
                    const my = mouse.y;
                    this.x += (mx - this.x) * 0.15;
                    this.y += (my - this.y) * 0.15;
                }

                // Ограничения экрана
                this.x = Math.max(this.width, Math.min(canvas.width - this.width, this.x));
                this.y = Math.max(this.height, Math.min(canvas.height - this.height, this.y));

                // Стрельба
                this.fireCooldown -= dt / 1000;
                if ((keys['Space'] || mouse.down || true) && this.fireCooldown <= 0) {
                    this.shoot();
                    this.fireCooldown = this.fireRate;
                }

                // Эффект двигателя
                if (Math.random() < 0.6) {
                    particles.push(new Particle(
                        this.x + (Math.random() * 12 - 6),
                        this.y + 20,
                        '#06b6d4', 2, Math.random() * 3 + 1, 0.2
                    ));
                }
            }

            shoot() {
                audio.playLaser();
                if (this.sprayShotTime > 0) {
                    // Спрей атака на 5 снарядов
                    for (let angle of [-0.4, -0.2, 0, 0.2, 0.4]) {
                        bullets.push(new Bullet(this.x, this.y - 15, angle, true));
                    }
                } else if (this.tripleShotTime > 0) {
                    // Тройной выстрел
                    bullets.push(new Bullet(this.x, this.y - 15, 0, true));
                    bullets.push(new Bullet(this.x - 15, y => y - 10, -0.15, true));
                    bullets.push(new Bullet(this.x + 15, y => y - 10, 0.15, true));
                } else {
                    // Обычный выстрел
                    bullets.push(new Bullet(this.x - 10, this.y - 15, 0, true));
                    bullets.push(new Bullet(this.x + 10, this.y - 15, 0, true));
                }
            }

            hit(damage) {
                audio.playHit();
                if (this.shield > 0) {
                    this.shield -= damage;
                    if (this.shield < 0) {
                        this.hp += this.shield; // остаток урона по HP
                        this.shield = 0;
                    }
                } else {
                    this.hp -= damage;
                }

                createExplosion(this.x, this.y, '#ec4899', 15, 2, 3);

                if (this.hp <= 0) {
                    this.hp = 0;
                    gameOver();
                }
                updateHUD();
            }

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);

                // Отрисовка щита при наличии
                if (this.shield > 0) {
                    ctx.strokeStyle = '#3b82f6';
                    ctx.lineWidth = 3;
                    ctx.shadowColor = '#3b82f6';
                    ctx.shadowBlur = 15;
                    ctx.beginPath();
                    ctx.arc(0, 0, this.width + 10, 0, Math.PI * 2);
                    ctx.stroke();
                }

                // Кораблик (Neon Triangle Ship)
                ctx.strokeStyle = this.color;
                ctx.fillStyle = '#090d16';
                ctx.lineWidth = 3;
                ctx.shadowColor = this.color;
                ctx.shadowBlur = 12;

                ctx.beginPath();
                ctx.moveTo(0, -this.height / 1.2);
                ctx.lineTo(this.width / 1.3, this.height / 1.3);
                ctx.lineTo(0, this.height / 2);
                ctx.lineTo(-this.width / 1.3, this.height / 1.3);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();

                // Ядро корабля
                ctx.fillStyle = '#ec4899';
                ctx.beginPath();
                ctx.arc(0, 0, 5, 0, Math.PI * 2);
                ctx.fill();

                ctx.restore();
            }
        }

        // --- Снаряды ---
        class Bullet {
            constructor(x, y, angle = 0, isPlayer = true) {
                this.x = typeof x === 'function' ? x() : x;
                this.y = typeof y === 'function' ? y() : y;
                this.speed = isPlayer ? 14 : 6;
                this.angle = angle;
                this.isPlayer = isPlayer;
                this.radius = isPlayer ? 3 : 4;
                this.color = isPlayer ? '#06b6d4' : '#ef4444';
            }

            update(dt) {
                this.x += Math.sin(this.angle) * this.speed * (dt / 16);
                this.y -= Math.cos(this.angle) * this.speed * (dt / 16) * (this.isPlayer ? 1 : -1);
            }

            draw() {
                ctx.save();
                ctx.fillStyle = this.color;
                ctx.shadowColor = this.color;
                ctx.shadowBlur = 8;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }

        let bullets = [];

        // --- Враги ---
        class Enemy {
            constructor(type, waveFactor = 1) {
                this.type = type; // 'asteroid', 'scout', 'destroyer'
                this.x = Math.random() * (canvas.width - 60) + 30;
                this.y = -50;
                
                if (type === 'asteroid') {
                    this.radius = Math.random() * 20 + 20;
                    this.hp = Math.floor(this.radius / 10) * waveFactor;
                    this.speed = Math.random() * 2 + 1.5;
                    this.color = '#a855f7';
                    this.rotation = 0;
                    this.rotSpeed = (Math.random() - 0.5) * 0.05;
                } else if (type === 'scout') {
                    this.radius = 18;
                    this.hp = 2 * waveFactor;
                    this.speed = Math.random() * 2 + 3.5;
                    this.color = '#ec4899';
                } else if (type === 'destroyer') {
                    this.radius = 35;
                    this.hp = 8 * waveFactor;
                    this.speed = 1;
                    this.color = '#eab308';
                    this.shootTimer = 0;
                }
                this.maxHp = this.hp;
            }

            update(dt, speedFactor = 1) {
                this.y += this.speed * speedFactor * (dt / 16);

                if (this.type === 'asteroid') {
                    this.rotation += this.rotSpeed;
                } else if (this.type === 'destroyer') {
                    this.shootTimer += dt / 1000;
                    if (this.shootTimer >= 2.0) {
                        this.shootTimer = 0;
                        // Стрельба врага по игроку
                        const angle = Math.atan2(player.x - this.x, player.y - this.y);
                        bullets.push(new Bullet(this.x, this.y, angle, false));
                    }
                }
            }

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.strokeStyle = this.color;
                ctx.shadowColor = this.color;
                ctx.shadowBlur = 10;
                ctx.lineWidth = 2;

                if (this.type === 'asteroid') {
                    ctx.rotate(this.rotation);
                    ctx.beginPath();
                    const pts = 7;
                    for (let i = 0; i < pts; i++) {
                        const a = (i / pts) * Math.PI * 2;
                        const r = this.radius * (0.8 + Math.sin(i * 3) * 0.2);
                        const px = Math.cos(a) * r;
                        const py = Math.sin(a) * r;
                        if (i === 0) ctx.moveTo(px, py);
                        else ctx.lineTo(px, py);
                    }
                    ctx.closePath();
                    ctx.stroke();
                } else if (this.type === 'scout') {
                    ctx.fillStyle = '#111827';
                    ctx.beginPath();
                    ctx.moveTo(0, this.radius);
                    ctx.lineTo(this.radius, -this.radius);
                    ctx.lineTo(-this.radius, -this.radius);
                    ctx.closePath();
                    ctx.fill();
                    ctx.stroke();
                } else if (this.type === 'destroyer') {
                    ctx.fillStyle = '#0f172a';
                    ctx.beginPath();
                    ctx.rect(-this.radius, -this.radius, this.radius * 2, this.radius * 2);
                    ctx.fill();
                    ctx.stroke();

                    // Индикатор здоровья над врагом
                    if (this.hp < this.maxHp) {
                        ctx.fillStyle = '#ef4444';
                        ctx.fillRect(-this.radius, -this.radius - 12, (this.hp / this.maxHp) * (this.radius * 2), 4);
                    }
                }

                ctx.restore();
            }
        }

        let enemies = [];

        // --- Бонусы (Power-ups) ---
        class PowerUp {
            constructor(x, y) {
                this.x = x;
                this.y = y;
                this.radius = 15;
                this.speed = 2;
                // Типы: heal, shield, triple, time
                const types = ['heal', 'shield', 'triple', 'spray', 'time'];
                this.type = types[Math.floor(Math.random() * types.length)];
                
                const colors = {
                    heal: '#22c55e',
                    shield: '#3b82f6',
                    triple: '#eab308',
                    spray: '#ec4899',
                    time: '#a855f7'
                };
                this.color = colors[this.type];
            }

            update(dt) {
                this.y += this.speed * (dt / 16);
            }

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.fillStyle = this.color;
                ctx.shadowColor = this.color;
                ctx.shadowBlur = 12;

                ctx.beginPath();
                ctx.arc(0, 0, this.radius, 0, Math.PI * 2);
                ctx.fill();

                // Иконка буквы
                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold 12px Orbitron';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                const symbols = { heal: '+', shield: 'S', triple: '3', spray: 'W', time: 'T' };
                ctx.fillText(symbols[this.type], 0, 0);

                ctx.restore();
            }
        }

        let powerUps = [];

        // --- Объект Игрока ---
        let player = new Player();

        // --- Спавн Врагов и Логика Волн ---
        function startWave() {
            enemiesToSpawn = 5 + wave * 4;
            waveTimer = 0;
            document.getElementById('waveText').innerText = wave;
        }

        function updateSpawns(dt) {
            if (enemiesToSpawn > 0) {
                waveTimer += dt / 1000;
                if (waveTimer >= Math.max(0.4, 2.0 - wave * 0.15)) {
                    waveTimer = 0;
                    enemiesToSpawn--;

                    // Выбор типа врага
                    const rand = Math.random();
                    let type = 'asteroid';
                    if (rand > 0.7 && wave >= 3) type = 'destroyer';
                    else if (rand > 0.4 && wave >= 2) type = 'scout';

                    enemies.push(new Enemy(type, 1 + wave * 0.2));
                }
            } else if (enemies.length === 0) {
                // Волна завершена
                wave++;
                startWave();
            }
        }

        // --- Обработка коллизий ---
        function checkCollisions() {
            // Пули и Враги
            for (let b = bullets.length - 1; b >= 0; b--) {
                const bullet = bullets[b];
                
                if (bullet.isPlayer) {
                    for (let e = enemies.length - 1; e >= 0; e--) {
                        const enemy = enemies[e];
                        const dist = Math.hypot(bullet.x - enemy.x, bullet.y - enemy.y);

                        if (dist < bullet.radius + enemy.radius) {
                            bullets.splice(b, 1);
                            enemy.hp--;

                            createExplosion(bullet.x, bullet.y, enemy.color, 6, 2, 2);

                            if (enemy.hp <= 0) {
                                audio.playExplosion(enemy.type === 'destroyer');
                                createExplosion(enemy.x, enemy.y, enemy.color, 25, 4, 5);

                                // Выпадение бонуса (20% шанс)
                                if (Math.random() < 0.20) {
                                    powerUps.push(new PowerUp(enemy.x, enemy.y));
                                }

                                score += (enemy.type === 'destroyer' ? 300 : enemy.type === 'scout' ? 150 : 100);
                                kills++;
                                enemies.splice(e, 1);
                                updateHUD();
                            }
                            break;
                        }
                    }
                } else {
                    // Вражеская пуля в игрока
                    const dist = Math.hypot(bullet.x - player.x, bullet.y - player.y);
                    if (dist < bullet.radius + player.width / 2) {
                        bullets.splice(b, 1);
                        player.hit(15);
                    }
                }
            }

            // Враги и Игрок
            for (let e = enemies.length - 1; e >= 0; e--) {
                const enemy = enemies[e];
                const dist = Math.hypot(player.x - enemy.x, player.y - enemy.y);

                if (dist < player.width / 1.5 + enemy.radius) {
                    audio.playExplosion(true);
                    createExplosion(enemy.x, enemy.y, enemy.color, 30, 4, 6);
                    player.hit(enemy.type === 'destroyer' ? 35 : 20);
                    enemies.splice(e, 1);
                }
            }

            // Бонусы и Игрок
            for (let p = powerUps.length - 1; p >= 0; p--) {
                const pu = powerUps[p];
                const dist = Math.hypot(player.x - pu.x, player.y - pu.y);

                if (dist < player.width / 1.5 + pu.radius) {
                    audio.playPowerup();
                    applyPowerUp(pu.type);
                    createExplosion(pu.x, pu.y, pu.color, 15, 3, 3);
                    powerUps.splice(p, 1);
                }
            }
        }

        function applyPowerUp(type) {
            if (type === 'heal') {
                player.hp = Math.min(player.maxHp, player.hp + 30);
            } else if (type === 'shield') {
                player.shield = player.maxShield;
            } else if (type === 'triple') {
                player.tripleShotTime = 8;
            } else if (type === 'spray') {
                player.sprayShotTime = 6;
            } else if (type === 'time') {
                player.timeSlowTime = 7;
            }
            updateHUD();
        }

        // --- Обновление HUD ---
        function updateHUD() {
            document.getElementById('scoreText').innerText = score;
            document.getElementById('hpText').innerText = `${Math.ceil(player.hp)}%`;
            document.getElementById('hpBar').style.width = `${Math.max(0, player.hp)}%`;

            const shieldHud = document.getElementById('shieldHud');
            if (player.shield > 0) {
                shieldHud.classList.remove('opacity-50');
                document.getElementById('shieldText').innerText = `${Math.ceil(player.shield)}%`;
                document.getElementById('shieldBar').style.width = `${player.shield}%`;
            } else {
                shieldHud.classList.add('opacity-50');
                document.getElementById('shieldText').innerText = 'ВЫКЛ';
                document.getElementById('shieldBar').style.width = '0%';
            }

            const timeIndicator = document.getElementById('timeSlowIndicator');
            if (player.timeSlowTime > 0) {
                timeIndicator.classList.remove('hidden');
            } else {
                timeIndicator.classList.add('hidden');
            }

            // Иконки бонусов
            const powersContainer = document.getElementById('activePowers');
            powersContainer.innerHTML = '';
            if (player.tripleShotTime > 0) {
                powersContainer.innerHTML += `<span class="px-2 py-1 bg-amber-500/20 border border-amber-400 text-amber-300 text-xs rounded-md font-orbitron">3X СТРЕЛЬБА (${Math.ceil(player.tripleShotTime)}s)</span>`;
            }
            if (player.sprayShotTime > 0) {
                powersContainer.innerHTML += `<span class="px-2 py-1 bg-pink-500/20 border border-pink-400 text-pink-300 text-xs rounded-md font-orbitron">СПРЕЙ (${Math.ceil(player.sprayShotTime)}s)</span>`;
            }
        }

        // --- Игровой Цикл ---
        function gameLoop(timestamp) {
            const dt = lastTime ? Math.min(timestamp - lastTime, 50) : 16.66;
            lastTime = timestamp;

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Скорость времени (Slow Motion)
            const timeFactor = player.timeSlowTime > 0 ? 0.4 : 1.0;

            updateStars(dt, timeFactor);
            drawStars();

            if (state === 'PLAYING') {
                player.update(dt);
                player.draw();

                // Обновление и отрисовка снарядов
                for (let i = bullets.length - 1; i >= 0; i--) {
                    bullets[i].update(dt);
                    bullets[i].draw();
                    if (bullets[i].y < -20 || bullets[i].y > canvas.height + 20) {
                        bullets.splice(i, 1);
                    }
                }

                // Обновление и отрисовка врагов
                updateSpawns(dt);
                for (let i = enemies.length - 1; i >= 0; i--) {
                    enemies[i].update(dt, timeFactor);
                    enemies[i].draw();
                    if (enemies[i].y > canvas.height + 50) {
                        enemies.splice(i, 1);
                        player.hit(10); // Штраф за пропущенного врага
                    }
                }

                // Обновление и отрисовка бонусов
                for (let i = powerUps.length - 1; i >= 0; i--) {
                    powerUps[i].update(dt);
                    powerUps[i].draw();
                    if (powerUps[i].y > canvas.height + 30) powerUps.splice(i, 1);
                }

                // Частицы
                for (let i = particles.length - 1; i >= 0; i--) {
                    particles[i].update(dt);
                    particles[i].draw();
                    if (particles[i].life <= 0) particles.splice(i, 1);
                }

                checkCollisions();
                updateHUD();
            }

            requestAnimationFrame(gameLoop);
        }

        // --- Управление состояниями игры ---
        function startGame() {
            audio.init();
            score = 0;
            kills = 0;
            wave = 1;
            bullets = [];
            enemies = [];
            powerUps = [];
            particles = [];
            player = new Player();

            document.getElementById('mainMenu').classList.add('hidden');
            document.getElementById('gameOverScreen').classList.add('hidden');
            document.getElementById('pauseScreen').classList.add('hidden');
            document.getElementById('hud').classList.remove('hidden');

            startWave();
            state = 'PLAYING';
        }

        function gameOver() {
            state = 'GAMEOVER';
            document.getElementById('hud').classList.add('hidden');
            document.getElementById('gameOverScreen').classList.remove('hidden');

            document.getElementById('finalScore').innerText = score;
            document.getElementById('finalWaves').innerText = wave;
            document.getElementById('finalKills').innerText = kills;

            const newMsg = document.getElementById('newHighscoreMsg');
            if (score > highScore) {
                highScore = score;
                localStorage.setItem('neon_defender_highscore', highScore);
                newMsg.classList.remove('hidden');
            } else {
                newMsg.classList.add('hidden');
            }
            updateHighScoreDisplay();
        }

        function togglePause() {
            if (state === 'PLAYING') {
                state = 'PAUSED';
                document.getElementById('pauseScreen').classList.remove('hidden');
            } else if (state === 'PAUSED') {
                state = 'PLAYING';
                document.getElementById('pauseScreen').classList.add('hidden');
            }
        }

        function updateHighScoreDisplay() {
            document.getElementById('menuHighScore').innerText = highScore;
            document.getElementById('hudHighScore').innerText = highScore;
        }

        // Настройка событий кнопок
        document.getElementById('startBtn').addEventListener('click', startGame);
        document.getElementById('restartBtn').addEventListener('click', startGame);
        document.getElementById('resumeBtn').addEventListener('click', togglePause);

        // Инициализация рекорда
        updateHighScoreDisplay();

        // Запуск анимационного цикла при загрузке
        window.onload = function() {
            requestAnimationFrame(gameLoop);
        };
    </script>
</body>
